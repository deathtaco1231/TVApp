{
  "manifest_version": 3,
  "name": "TVApp popup guard",
  "version": "1.0.0",
  "description": "Blocks the ad popups that stream embeds open when you press play.",
  "content_scripts": [
    {
      "matches": ["*://embed.st/*", "*://*.embed.st/*"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["block.js"]
    }
  ]
}
